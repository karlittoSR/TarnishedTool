<Window x:Class="TarnishedTool.Views.Windows.IgtOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGT"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <TextBlock x:Name="IgtText"
               Text="IGT 00:00:00.00"
               Foreground="#EAEAEA"
               FontSize="14"
               FontFamily="Consolas"
               FontWeight="SemiBold"
               Padding="4,2">
        <TextBlock.Effect>
            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="1" />
        </TextBlock.Effect>
    </TextBlock>
</Window>
