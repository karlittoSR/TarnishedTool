<windows:TopmostWindow x:Class="TarnishedTool.Views.Windows.SavedLinesWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:controls="clr-namespace:TarnishedTool.Controls"
                       xmlns:windows="clr-namespace:TarnishedTool.Views.Windows"
                       mc:Ignorable="d"
                       Style="{StaticResource DefaultWindowStyle}"
                       WindowStyle="None"
                       AllowsTransparency="True"
                       Title="Saved Segments" Height="520" Width="380">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" Title="Saved Segments" />

        <Grid Grid.Row="1">
            <CheckBox x:Name="AlwaysOnTopCheckBox"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Checked="AlwaysOnTopCheckBox_Checked"
                      Unchecked="AlwaysOnTopCheckBox_Unchecked">
                Always on Top
            </CheckBox>
        </Grid>

        <ListBox x:Name="SavedLinesList"
                 Grid.Row="2"
                 Margin="10,0,10,0"
                 ItemsSource="{Binding Lines}"
                 SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                 MouseDoubleClick="SavedLinesList_MouseDoubleClick"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="SavedLinesList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="SavedLinesList_PreviewMouseMove"
                 DragOver="SavedLinesList_DragOver"
                 Drop="SavedLinesList_Drop"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,3" />
                    <Setter Property="ToolTip" Value="Drag to reorder" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SnapshotMarker}" Foreground="#3498db"
                                   FontWeight="Bold" Margin="6,0,0,0"
                                   ToolTip="Has a saved character state (gear + stats)" />
                        <TextBlock Grid.Column="2" Text="{Binding BestText}" Foreground="Gold"
                                   FontWeight="SemiBold" Margin="10,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Ash of war: chosen per weapon because the mounted ash cannot be read
             back off a weapon, so it has to be recorded with the save. -->
        <Border Grid.Row="3" BorderThickness="1" BorderBrush="#333" CornerRadius="3"
                Margin="10,8,10,0" Padding="8">
            <Border.ToolTip>
                <ToolTip MaxWidth="320">
                    <TextBlock TextWrapping="Wrap"
                               Text="Ash of War for this save's weapons.&#x0a;&#x0a;When you load a save, any weapon you don't already own has to be spawned — and a spawned weapon only ever comes with its class default skill, because the ash you mounted can't be read back off the original. Pick the ash here and it gets stored with the save, so the weapon is spawned with the right skill (and stays correct when you share the save or upgrade the weapon).&#x0a;&#x0a;Weapons you already own are equipped untouched and keep their ash regardless." />
                </ToolTip>
            </Border.ToolTip>
            <StackPanel>
                <TextBlock Text="Ash of War" FontWeight="SemiBold" Margin="0,0,0,5" />
                <ComboBox ItemsSource="{Binding LineWeapons}"
                          SelectedItem="{Binding SelectedLineWeapon, Mode=TwoWay}"
                          DisplayMemberPath="Display"
                          Height="26" VerticalContentAlignment="Center"
                          ToolTip="Weapon in this save." />
                <ComboBox ItemsSource="{Binding AshOptions}"
                          SelectedItem="{Binding SelectedAsh, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Margin="0,4,0,0"
                          Height="26" VerticalContentAlignment="Center"
                          ToolTip="Ash of War to give that weapon when it has to be spawned." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="10,7,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="Load" Height="28" Margin="3"
                    IsEnabled="{Binding CanOperate}"
                    Command="{Binding LoadCommand}"
                    ToolTip="Load this saved segment and immediately restore to its start." />
            <Button Grid.Row="0" Grid.Column="1" Content="Save Current" Height="28" Margin="3"
                    IsEnabled="{Binding CanOperate}"
                    Command="{Binding SaveCurrentCommand}"
                    ToolTip="Save the current segment and character state as a new library entry." />
            <Button Grid.Row="0" Grid.Column="2" Content="Import" Height="28" Margin="3"
                    Command="{Binding ImportFileCommand}"
                    ToolTip="Import one or more complete saved segments from a JSON file." />
            <Button Grid.Row="0" Grid.Column="3" x:Name="ExportButton" Content="Export ▾" Height="28" Margin="3"
                    Click="ExportButton_Click"
                    ToolTip="Export the selected saved segment or the complete library to JSON.">
                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem x:Name="ExportSelectedMenuItem" Header="Selected segment"
                                  Click="ExportSelectedMenuItem_Click" />
                        <MenuItem x:Name="ExportAllMenuItem" Header="All segments (lines.json)"
                                  Click="ExportAllMenuItem_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Grid.Row="1" Grid.Column="0" Content="Update" Height="28" Margin="3"
                    IsEnabled="{Binding CanOperate}"
                    Command="{Binding UpdateCommand}"
                    ToolTip="Update the selected segment with the current positions, radii and character state, keeping its name and PB." />
            <!-- Debug-only: Load already restores and applies the character. Kept
                 collapsed so the per-step apply error report stays reachable. -->
            <Button Grid.Row="1" Grid.Column="3" Content="Apply Char" Height="28" Margin="3"
                    Visibility="Collapsed"
                    Command="{Binding ApplyCharacterCommand}"
                    ToolTip="Apply this save's character state (stats then gear) to your character." />
            <Button Grid.Row="1" Grid.Column="1" Content="Rename" Height="28" Margin="3"
                    Command="{Binding RenameCommand}" />
            <Button Grid.Row="1" Grid.Column="2" Content="Delete" Height="28" Margin="3"
                    Command="{Binding DeleteCommand}" />
        </Grid>
    </Grid>
</windows:TopmostWindow>
