<Window x:Class="TarnishedTool.Views.Windows.SlopeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump Slope"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#8C000000"
            CornerRadius="16"
            Padding="6"
            ToolTip="{Binding SlopeIndicatorTooltip, Mode=OneWay}"
            ToolTipService.InitialShowDelay="300">
        <Ellipse Width="20"
                 Height="20"
                 Fill="{Binding SlopeIndicatorBrush, Mode=OneWay}"
                 Stroke="#40FFFFFF"
                 StrokeThickness="1">
            <Ellipse.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="Black" Opacity="1" />
            </Ellipse.Effect>
        </Ellipse>
    </Border>
</Window>
