<Window x:Class="TarnishedTool.Views.Windows.SlopeOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump Slope"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <!-- Transparent, so only the dot is visible. The panel still hit-tests, which keeps
         the whole window draggable and leaves room for the dot's glow to render unclipped. -->
    <Grid Background="Transparent"
          ToolTip="{Binding SlopeIndicatorTooltip, Mode=OneWay}"
          ToolTipService.InitialShowDelay="300">
        <Ellipse Width="20"
                 Height="20"
                 Margin="6"
                 Fill="{Binding SlopeIndicatorBrush, Mode=OneWay}"
                 Stroke="#59000000"
                 StrokeThickness="1">
            <Ellipse.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="Black" Opacity="1" />
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</Window>
