<windows:TopmostWindow x:Class="TarnishedTool.Views.Windows.LineComparisonWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:controls="clr-namespace:TarnishedTool.Controls"
                       xmlns:windows="clr-namespace:TarnishedTool.Views.Windows"
                       mc:Ignorable="d"
                       Style="{StaticResource DefaultWindowStyle}"
                       WindowStyle="None"
                       AllowsTransparency="True"
                       Title="Segment Timer" Height="600" Width="500">
    <windows:TopmostWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </windows:TopmostWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Subtle gold flash on a new best (animated from code-behind) -->
        <Border x:Name="GoldFlash"
                Grid.Row="0" Grid.RowSpan="3"
                Background="Gold"
                Opacity="0"
                IsHitTestVisible="False"
                Panel.ZIndex="100" />

        <controls:TitleBar Grid.Row="0" Title="Segment Timer" />

        <Grid Grid.Row="1">
            <CheckBox x:Name="AlwaysOnTopCheckBox"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Checked="AlwaysOnTopCheckBox_Checked"
                      Unchecked="AlwaysOnTopCheckBox_Unchecked">
                Always on top
            </CheckBox>
        </Grid>

        <Grid Grid.Row="2" Margin="10,2,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Start -->
            <Border Grid.Row="0" BorderThickness="1" BorderBrush="#333" CornerRadius="3" Padding="6" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Set Start" Width="82" Height="26"
                            IsEnabled="{Binding CanOperate}"
                            Command="{Binding SetStartCommand}" />
                    <TextBlock Grid.Column="1" Text="{Binding StartText}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Radius:" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Width="45" Text="{Binding StartRadius, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- End -->
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="#333" CornerRadius="3" Padding="6" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Width="90" Height="26" Margin="0,0,7,0"
                              ItemsSource="{Binding FinishTypeOptions}"
                              SelectedIndex="{Binding SelectedFinishTypeIndex, Mode=TwoWay}"
                              ToolTip="Choose whether the segment ends at a position or when an event flag changes." />

                    <Grid Grid.Column="1"
                          Visibility="{Binding IsPositionFinish, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Set Finish" Width="82" Height="26"
                                IsEnabled="{Binding CanOperate}"
                                Command="{Binding SetEndCommand}" />
                        <TextBlock Grid.Column="1" Text="{Binding EndText}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Radius:" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="45" Text="{Binding EndRadius, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsEventFlagFinish, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Flag ID:" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Width="120" MaxLength="10" VerticalContentAlignment="Center"
                                 Text="{Binding EndFlagIdText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Enter the event ID found with the Event Flag Scanner." />
                        <TextBlock Text="Value:" VerticalAlignment="Center" Margin="12,0,5,0" />
                        <ComboBox Width="55" Height="24"
                                  ItemsSource="{Binding FlagValueOptions}"
                                  SelectedIndex="{Binding SelectedFlagValueIndex, Mode=TwoWay}"
                                  ToolTip="Finish when the flag transitions to this value." />
                        <Button Content="Scan" Width="52" Height="24" Margin="10,0,0,0"
                                IsEnabled="{Binding CanOperate}"
                                Command="{Binding ScanEventFlagsCommand}"
                                ToolTip="Open TarnishedTool's Event Logger to find a flag ID." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Controls -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,6">
                <Button Content="Reset to Start" Width="120" Height="28" Margin="0,0,6,0"
                        IsEnabled="{Binding CanOperate}"
                        Command="{Binding RestoreToStartCommand}"
                        ToolTip="Restore the start position, revive nearby bosses, reset mobs and refill flasks." />
                <Button Content="Saved Segments" Width="130" Height="28"
                        Command="{Binding OpenSavedLinesCommand}"
                        ToolTip="Open the saved-segment library." />
            </StackPanel>

            <!-- Live timer + status -->
            <StackPanel Grid.Row="3" Margin="0,0,0,2">
                <TextBlock Text="{Binding LiveTimeText}" FontSize="36" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="Status: " />
                    <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TargetPbText}" Foreground="Gold" FontWeight="SemiBold" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding TargetReferenceText}" Foreground="#3498db" FontWeight="SemiBold" Margin="14,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding FeedbackText}"
                           Foreground="White"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           Height="16"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Next attempt name -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5,0,5" VerticalAlignment="Center">
                <TextBlock Text="Attempt name:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="220" VerticalContentAlignment="Center" MaxLength="44"
                         Text="{Binding NextAttemptName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Optional name for the next completed attempt." />
            </StackPanel>

            <!-- Results table -->
            <DataGrid Grid.Row="5"
                      ItemsSource="{Binding Attempts}"
                      SelectedItem="{Binding SelectedAttempt, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      RowHeight="22"
                      ColumnHeaderHeight="24"
                      BeginningEdit="AttemptsGrid_BeginningEdit"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReference}" Value="True">
                                <Setter Property="Foreground" Value="#3498db" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                <Setter Property="Foreground" Value="Gold" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding NumberText}" IsReadOnly="True" Width="40" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="MaxLength" Value="44" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Time" Binding="{Binding ResultText}" IsReadOnly="True" Width="110" />
                    <DataGridTextColumn Header="Delta" Binding="{Binding DeltaText}" IsReadOnly="True" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Table actions -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Remove Selected" Width="120" Height="26" Margin="0,0,8,0"
                        Command="{Binding RemoveSelectedCommand}"
                        ToolTip="Remove the selected attempt. Selecting PB or Reference explicitly deletes that saved comparison." />
                <Button Content="Clear Runs" Width="85" Height="26"
                        Command="{Binding ClearResultsCommand}"
                        ToolTip="Clear this session's attempts while keeping the saved PB and reference." />
            </StackPanel>
        </Grid>
    </Grid>
</windows:TopmostWindow>
