<windows:TopmostWindow x:Class="TarnishedTool.Views.Windows.LineComparisonWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:controls="clr-namespace:TarnishedTool.Controls"
                       xmlns:windows="clr-namespace:TarnishedTool.Views.Windows"
                       mc:Ignorable="d"
                       Style="{StaticResource DefaultWindowStyle}"
                       WindowStyle="None"
                       AllowsTransparency="True"
                       Title="Line Comparison" Height="600" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Subtle gold flash on a new best (animated from code-behind) -->
        <Border x:Name="GoldFlash"
                Grid.Row="0" Grid.RowSpan="3"
                Background="Gold"
                Opacity="0"
                IsHitTestVisible="False"
                Panel.ZIndex="100" />

        <controls:TitleBar Grid.Row="0" Title="Line Comparison" />

        <Grid Grid.Row="1">
            <CheckBox x:Name="AlwaysOnTopCheckBox"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                      Checked="AlwaysOnTopCheckBox_Checked"
                      Unchecked="AlwaysOnTopCheckBox_Unchecked">
                Always on Top
            </CheckBox>
        </Grid>

        <Grid Grid.Row="2" Margin="12,4,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Start -->
            <Border Grid.Row="0" BorderThickness="1" BorderBrush="#333" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Set Start" Width="90" Height="28"
                            IsEnabled="{Binding CanOperate}"
                            Command="{Binding SetStartCommand}" />
                    <TextBlock Grid.Column="1" Text="{Binding StartText}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Width="45" Text="{Binding StartRadius}" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- End -->
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="#333" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Set End" Width="90" Height="28"
                            IsEnabled="{Binding CanOperate}"
                            Command="{Binding SetEndCommand}" />
                    <TextBlock Grid.Column="1" Text="{Binding EndText}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox Width="45" Text="{Binding EndRadius}" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Controls -->
            <StackPanel Grid.Row="2" Margin="0,2,0,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Export position" Width="110" Height="30" Margin="0,0,6,0"
                            IsEnabled="{Binding CanExport}"
                            Command="{Binding ExportPositionsCommand}" />
                    <Button Content="Restore to Start" Width="140" Height="30" Margin="0,0,6,0"
                            IsEnabled="{Binding CanOperate}"
                            Command="{Binding RestoreToStartCommand}" />
                    <Button Content="Import position" Width="110" Height="30" Margin="0,0,6,0"
                            Command="{Binding ImportPositionsCommand}" />
                    <Button Content="Saves" Width="65" Height="30"
                            Command="{Binding OpenSavedLinesCommand}" />
                </StackPanel>
                <TextBlock Text="Restore to Start also resets the zone: bosses nearby are revived to their first-encounter state, mobs reset and flasks refill."
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="440"
                           TextAlignment="Center"
                           Foreground="#999"
                           FontSize="11"
                           Margin="0,6,0,0" />
            </StackPanel>

            <!-- Live timer + status -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="{Binding LiveTimeText}" FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="Status: " />
                    <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TargetPbText}" Foreground="Gold" FontWeight="SemiBold" Margin="14,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding FeedbackText}"
                           Foreground="White"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           Height="16"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Next attempt name -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,6" VerticalAlignment="Center">
                <TextBlock Text="Next attempt name:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="220" VerticalContentAlignment="Center" MaxLength="44"
                         Text="{Binding NextAttemptName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Results table -->
            <DataGrid Grid.Row="5"
                      ItemsSource="{Binding Attempts}"
                      SelectedItem="{Binding SelectedAttempt, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="True"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                <Setter Property="Foreground" Value="Gold" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="40" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="MaxLength" Value="44" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Result" Binding="{Binding ResultText}" IsReadOnly="True" Width="110" />
                    <DataGridTextColumn Header="Delta" Binding="{Binding DeltaText}" IsReadOnly="True" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Table actions -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Remove Selected" Width="120" Height="26" Margin="0,0,8,0"
                        Command="{Binding RemoveSelectedCommand}" />
                <Button Content="Copy" Width="80" Height="26" Margin="0,0,8,0"
                        Command="{Binding CopyResultsCommand}" />
                <Button Content="Clear" Width="80" Height="26"
                        Command="{Binding ClearResultsCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</windows:TopmostWindow>
