<Window x:Class="TarnishedTool.Views.Windows.HotkeyNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border x:Name="NotificationBorder"
            Background="#CC1A1A1A"
            BorderBrush="{Binding StateColor}"
            BorderThickness="2"
            CornerRadius="5"
            Padding="15,10"
            Margin="5">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="3" BlurRadius="10" Color="Black" Opacity="0.7" />
        </Border.Effect>

        <TextBlock x:Name="NotificationText"
                   Text="{Binding DisplayText}"
                   Foreground="#EAEAEA"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Color="Black" Opacity="0.8" />
            </TextBlock.Effect>
        </TextBlock>
    </Border>
</Window>
