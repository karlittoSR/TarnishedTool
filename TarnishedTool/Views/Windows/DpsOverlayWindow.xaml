<Window x:Class="TarnishedTool.Views.Windows.DpsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DPS"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#B2000000" CornerRadius="4" Padding="8,5">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- DPS -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DPS"
                               FontSize="9"
                               FontFamily="Consolas"
                               Foreground="#888888"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding FightDpsText, Mode=OneWay}"
                               FontSize="15"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="#E8C97A"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Total -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Total"
                               FontSize="9"
                               FontFamily="Consolas"
                               Foreground="#888888"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding FightTotalDamageText, Mode=OneWay}"
                               FontSize="15"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="#EAEAEA"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Duration -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Time"
                               FontSize="9"
                               FontFamily="Consolas"
                               Foreground="#888888"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding FightDuration, Mode=OneWay}"
                               FontSize="15"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="#EAEAEA"
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="Black" Opacity="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
